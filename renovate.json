{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^hearth/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Helmetica dev tags are sorted numerically. Semver would read v0.1.0-dev9 as newer than v0.1.0-dev21. Grouping keeps the crd/default refs and the image tag of a component on the same version.",
      "matchFileNames": [
        "hearth/helmetica/**"
      ],
      "groupName": "helmetica",
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions in Justfiles annotated with a `# renovate:` comment",
      "managerFilePatterns": [
        "/(^|/)Justfile$/",
        "/\\.just$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: registryUrl=(?<registryUrl>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\n[A-Z0-9_]+ := \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update the just version used to bootstrap the devcontainer and CI",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)\\nENV [A-Z0-9_]+=\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)\\n\\s*just-version: '(?<currentValue>[^']+)'"
      ]
    }
  ]
}